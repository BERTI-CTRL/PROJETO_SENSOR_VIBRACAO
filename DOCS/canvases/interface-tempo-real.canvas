{
  "nodes": [
    {"id": "titulo", "type": "text", "text": "# Interface em tempo real\nComo a Janela usa timers para mostrar dados sem ler a serial diretamente.", "x": 0, "y": -300, "width": 780, "height": 90, "color": "4"},
